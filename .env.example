# Copy the variables you need into your hosting provider's secrets (Vercel → Settings →
# Environment Variables). Never commit real values.
#
# Booking calls uses Cal.com and needs no keys — set the link in src/lib/site.ts (contact.calLink).

# Contact form storage (Supabase). Optional — the Automa8 project is the built-in default.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Contact form email notification via Resend (https://resend.com). Optional.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=hello@automa8.co
# Must use a domain verified in Resend
ENQUIRY_FROM_EMAIL=Automa8 Website <website@automa8.co>

# Admin area (/admin) — the proposal builder. Leave ADMIN_PASSWORD empty and the admin area stays
# switched off: nobody can sign in. Use something long; 12 characters is the minimum accepted.
ADMIN_PASSWORD=
# Optional. Signs the admin session cookie; derived from ADMIN_PASSWORD when left empty.
ADMIN_SESSION_SECRET=

# Reading and writing proposals needs the Supabase service role key. Server-side only — it never
# reaches the browser, and it must never be prefixed VITE_.
SUPABASE_SERVICE_ROLE_KEY=
